# =============================================================================
#  CFL Live — https://cfelbd.hekzor.com
#
#  Copy to cfelbd-live.env (same folder), fill in the two CHANGE_ME secrets,
#  then:  sudo ./deploy/deploy.sh cfelbd-live
#
#  cfelbd-live.env is gitignored — never commit real secrets.
# =============================================================================

# ── Identity (namespaces this instance on the host) ──────────────────────────
COMPOSE_PROJECT_NAME=cfelbd-live
DB_CONTAINER=postgres-cfelbd
API_CONTAINER=orghub-cfl-api
WEB_CONTAINER=orghub-cfl-web

# ── Image tags (UNIQUE per instance — do not reuse across instances) ─────────
API_IMAGE=orghub-api:cfelbd-live
WEB_IMAGE=orghub-web:cfelbd-live

# ── Host ports (bound to 127.0.0.1; nginx proxies the public domain here) ────
API_PORT=5178
WEB_PORT=5179
DB_PORT=5437

# ── Database ─────────────────────────────────────────────────────────────────
DB_NAME=orghub_cfl_live
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# ── Application ──────────────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=CFLLive
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARS_LONG_SECRET_KEY
JWT_ISSUER=uOrgHubCFL
JWT_AUDIENCE=uOrgHubCFL-clients
ALLOWED_ORIGINS=https://cfelbd.hekzor.com
VITE_API_URL=https://cfelbd.hekzor.com/api/v1

# ── Deploy metadata (used by deploy.sh) ──────────────────────────────────────
DOMAIN=https://cfelbd.hekzor.com
GIT_BRANCH=master
