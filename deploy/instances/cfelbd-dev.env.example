# =============================================================================
#  CFL Dev — https://cfelbd-dev.hekzor.com
#
#  Copy to cfelbd-dev.env (same folder), fill in the two CHANGE_ME secrets,
#  then:  sudo ./deploy/deploy.sh cfelbd-dev
#
#  cfelbd-dev.env is gitignored — never commit real secrets.
# =============================================================================

# ── Identity (namespaces this instance on the host) ──────────────────────────
COMPOSE_PROJECT_NAME=cfelbd-dev
DB_CONTAINER=postgres-cfelbd-dev
API_CONTAINER=orghub-cfl-dev-api
WEB_CONTAINER=orghub-cfl-dev-web

# ── Image tags (UNIQUE per instance — do not reuse across instances) ─────────
API_IMAGE=orghub-api:cfelbd-dev
WEB_IMAGE=orghub-web:cfelbd-dev

# ── Host ports (bound to 127.0.0.1; nginx proxies the public domain here) ────
API_PORT=5180
WEB_PORT=5181
DB_PORT=5438

# ── Database ─────────────────────────────────────────────────────────────────
DB_NAME=orghub_cfl_dev
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# ── Existing data (migration only) ───────────────────────────────────────────
# This instance already has data in volumes created by the old compose. Point
# at them so the new stack reuses the existing database instead of a blank one.
# New instances: leave these commented.
DB_VOLUME=orghub-source_postgres-cfelbd-dev-data
UPLOADS_VOLUME=orghub-source_uorghub-cfl-dev-uploads

# ── Application ──────────────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=CFLDev
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARS_LONG_SECRET_KEY
JWT_ISSUER=uOrgHubCFLDev
JWT_AUDIENCE=uOrgHubCFLDev-clients
ALLOWED_ORIGINS=https://cfelbd-dev.hekzor.com
VITE_API_URL=https://cfelbd-dev.hekzor.com/api/v1

# ── Deploy metadata (used by deploy.sh) ──────────────────────────────────────
DOMAIN=https://cfelbd-dev.hekzor.com
GIT_BRANCH=master
