# =============================================================================
#  uOrgHub Main — https://uorghub.hekzor.com / https://uorghub.unitymicrofund.com
#
#  Copy to uorghub.env (same folder), fill in the two CHANGE_ME secrets,
#  then:  sudo ./deploy/deploy.sh uorghub
#
#  NOTE: the main instance currently deploys via docker-compose.prod.yml in
#  /opt/uorghub. Migrating it to this unified flow is optional and can be done
#  last, after CFL live/dev are proven. See deploy/README.md.
#
#  uorghub.env is gitignored — never commit real secrets.
# =============================================================================

# ── Identity (namespaces this instance on the host) ──────────────────────────
COMPOSE_PROJECT_NAME=uorghub
DB_CONTAINER=uorghub-db
API_CONTAINER=uorghub-api
WEB_CONTAINER=uorghub-web

# ── Image tags (UNIQUE per instance — do not reuse across instances) ─────────
API_IMAGE=orghub-api:uorghub
WEB_IMAGE=orghub-web:uorghub

# ── Host ports (bound to 127.0.0.1; nginx proxies the public domain here) ────
API_PORT=5177
WEB_PORT=3001
DB_PORT=5436

# ── Database ─────────────────────────────────────────────────────────────────
DB_NAME=orgHub
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# ── Existing data (migration only) ───────────────────────────────────────────
# This instance already has data in volumes created by the old compose. Point
# at them so the new stack reuses the existing database instead of a blank one.
# New instances: leave these commented.
DB_VOLUME=uorghub_uorghub-db-data
UPLOADS_VOLUME=uorghub_uorghub-uploads

# ── Application ──────────────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARS_LONG_SECRET_KEY
JWT_ISSUER=uOrgHub
JWT_AUDIENCE=uOrgHub-clients
ALLOWED_ORIGINS=https://uorghub.unitymicrofund.com
VITE_API_URL=https://uorghub.unitymicrofund.com/api/v1

# ── Deploy metadata (used by deploy.sh) ──────────────────────────────────────
DOMAIN=https://uorghub.hekzor.com
GIT_BRANCH=master
